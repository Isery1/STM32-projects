[Unit]
Description=Raspberry Pi RFID Server Sync Daemon
After=network-online.target
Wants=network-online.target

[Service]
# Executed as your Pi username. Change 'pi' if you configured a custom username!
User=pi

# The root folder of your project
WorkingDirectory=/home/pi/RFID_Pi

# Path to the Python executable INSIDE your Virtual Environment to run the script
ExecStart=/home/pi/RFID_Pi/venv/bin/python3 main.py

# Robust restarts: if the app crashes, automatically try to restart it after 5 seconds
Restart=always
RestartSec=5

# Standard Output/Error redirects to system journal (viewable via journalctl)
StandardOutput=append:/home/pi/RFID_Pi/service.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
