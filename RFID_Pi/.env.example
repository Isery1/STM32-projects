# ManageIO terminal — environment template (copy to ".env" on the Pi; never commit real secrets).
SERVER_URL=https://your-server.example/rfid_api.php?action=
AUTH_ENDPOINT=login
SCAN_ENDPOINT=scan
HEARTBEAT_ENDPOINT=heartbeat
QUERY_ENDPOINT=query_punch_status

DEVICE_ID=your-device-id
DEVICE_SECRET=your-shared-secret

SCAN_COOLDOWN_SECONDS=2.0
HEARTBEAT_INTERVAL_SECONDS=45.0

# Set to true for dev without hardware
USE_MOCK_RFID=false

# Skip startup hardware/network/server checks (optional)
# SKIP_BOOT_CHECKS=1
