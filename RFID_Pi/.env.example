# ManageIO terminal — environment template (copy to ".env" on the Pi; never commit real secrets).
# Same backend base URL as the frontend EXPO_PUBLIC_API_URL.
SERVER_URL=https://api.zk-digital.at/backend-api
ENROLL_ENDPOINT=terminal/enroll
AUTH_ENDPOINT=terminal/login
SCAN_ENDPOINT=terminal/stamps
HEARTBEAT_ENDPOINT=terminal/heartbeat
BOOT_CHECK_ENDPOINT=terminal/boot-check
QUERY_ENDPOINT=terminal/query

DEVICE_ID=test_terminal_1
TERMINAL_SERIAL=MIO1-COMPANY01-H8K4-2P9Q-X7VD-93LA
# Created automatically after first successful enrollment. Keep this file private.
TERMINAL_API_KEY_FILE=.terminal_api_key
# Optional dev override; prefer the file on the Pi.
# TERMINAL_API_KEY=mio_test_xxxxxxxxxxxxxxxxx

SCAN_COOLDOWN_SECONDS=2.0
HEARTBEAT_INTERVAL_SECONDS=45.0

# Set to true for dev without hardware
USE_MOCK_RFID=false

# Skip startup hardware/network/server checks (optional)
# SKIP_BOOT_CHECKS=1
